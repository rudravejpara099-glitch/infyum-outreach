# Copy to .env.local (it is never committed). Run `npm run ready` any time to see what is still missing.
# Only SESSION_SECRET is needed for local use; everything below it switches on one feature.

# A long random value that signs logins and encrypts the stored Google Sheets token. Keep it stable:
# changing it logs everyone out and makes the stored Google connection unreadable (you just connect again).
SESSION_SECRET=

# The public address of this app. Google sends people back to it, so the redirect addresses added in Google Cloud must start with it.
APP_URL=http://localhost:3000

# ---- Claude writes the messages and comments (paid, metered; needs credit on the key and `npm run setup:claude`)
# ANTHROPIC_API_KEY=
# The free local model instead (quality is lower). Leave AI_PROVIDER out to use Claude.
# AI_PROVIDER=local
# LOCAL_AI_MODEL=qwen3.5:latest

# ---- Apify finds leads (the Find leads button). Needs a monthly limit: `npm run setup:claude -- --limit 10 --apify-cap 5 --yes`
# APIFY_TOKEN=

# ---- Google: the Sheet and Google sign-in. One OAuth "Web application" client; add BOTH redirect addresses to it:
#   <APP_URL>/api/auth/google/callback      and      <APP_URL>/api/sheets/google/callback
# and turn on the Google Sheets API for the project.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Billing owner: the user id that may change prices and limits (1 is the first account you created)
BILLING_OWNER_USER_ID=1

# ---- Safety
# Human-speed pacing (working hours, rests, waits between jobs) is ON. Instagram locked the test account when it was off.
# HUMAN_PACING=off

# ---- Optional
# DB_PATH=
# PROFILES_DIR=
# Billing is TEST-only; configure Stripe privately and never commit real credentials.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# BILLING_DEPLOYMENT=
