# Copy to .env.local. Every value is optional for local use.
SESSION_SECRET=change-me-to-a-long-random-string
# AI_MODEL=sonnet
# DB_PATH=./data/outreach.db
# PROFILES_DIR=./data/profiles

# Optional free server-side writing, using an installed local Ollama model only.
# AI_PROVIDER=local
# LOCAL_AI_MODEL=qwen2.5:7b
# No paid fallback is used; otherwise the default provider is metered Anthropic.

# Billing is TEST-only. Configure privately; never commit real credentials.
# Explicit existing app user ID; no owner is inferred automatically.
# BILLING_OWNER_USER_ID=123
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# APP_URL=http://127.0.0.1:3100
# BILLING_DEPLOYMENT=local

# Google sign-in (optional). Create an OAuth "Web application" client in Google Cloud and add this redirect URI:
#   <APP_URL>/api/auth/google/callback      for example http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# The public address of this app. It must match the address used above.
# APP_URL=http://localhost:3000
