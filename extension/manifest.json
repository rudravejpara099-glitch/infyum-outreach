{
  "manifest_version": 3,
  "name": "Infyum Outreach",
  "version": "0.1.0",
  "description": "Lets your Outreach workspace read Instagram pages in your own signed-in Chrome.",
  "permissions": [
    "alarms",
    "storage",
    "scripting",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "http://localhost:3000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Infyum Outreach"
  }
}
